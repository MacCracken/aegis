# pam.cyr — PAM inspection and user/session management
# Ported from rust-old/src/pam.rs
#
# Provides PAM service enumeration, config parsing, passwd parsing,
# who output parsing, and username validation.
#
# Requires: lib/string.cyr, lib/str.cyr, lib/vec.cyr, lib/fs.cyr,
#           lib/process.cyr, lib/syscalls.cyr, src/error.cyr
#
# All structs are bags of i64 fields accessed via store64/load64.
# Strings are Str (fat pointer: data + length) from lib/str.cyr.

#define LINUX
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/process.cyr"
include "lib/fs.cyr"

# ================================================================
# fd → Str reader (local)
# ================================================================

# Read up to `cap` bytes from `fd` and return them as a NUL-terminated
# Str. Was `agnosys_read_fd_to_str` from the old agnosys library, which
# was decomposed 2026-06-19 (trust→sigil, security/mac/audit→kavach,
# pam→aegis, logging→sakshi, udev/drm→agnodrm) — the fd-read util did
# not survive into any module aegis depends on, so it lives here now.
fn pam_read_fd_to_str(fd, cap): i64 {
    var buf = alloc(cap + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n == 0 - EINTR) {
            # A signal is not end-of-file. Treating it as one silently
            # truncated the security config being parsed, which for a
            # `required` line means reading a weaker policy than is on disk.
            rgo = 1;
        } elif (n <= 0) {
            rgo = 0;
        } else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    store8(buf + total, 0);
    return str_new(buf, total);
}

# O_NOFOLLOW is not exported by the cyrius stdlib yet; src/lib.cyr carries
# the same local constant for the F-6 scanner fix. Drop both when it lands.
var _PAM_O_NOFOLLOW = 131072;

# Cap on `who` capture. The buffer is allocated at cap+1 so the NUL
# terminator below always lands inside the allocation — run_capture can
# return exactly `cap`.
var _PAM_WHO_CAP = 16384;

# ================================================================
# Byte-class allowlists
#
# Every validator in aegis is an allowlist (see _aegis_valid_agent_id in
# src/lib.cyr) because the 2026-05-10 audit's F-2 established that
# denylists lose. These are the PAM-side equivalents.
#
# The rendering context is what makes the byte set load-bearing:
# pam_render_rule joins fields with TAB and pam_render_config joins lines
# with LF, so any control byte surviving validation becomes a structural
# character in the emitted /etc/pam.d file.
# ================================================================

# Reject anything outside printable ASCII, and any byte not in `extra`.
# `extra` is a cstr of additionally-permitted punctuation.
fn _pam_str_allowed(sv, extra_cstr, maxlen): i64 {
    var n = str_len(sv);
    if (n == 0) { return 0; }
    if (n > maxlen) { return 0; }
    var d = str_data(sv);
    var elen = strlen(extra_cstr);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 0x30) { if (c <= 0x39) { ok = 1; } }   # 0-9
        if (c >= 0x41) { if (c <= 0x5A) { ok = 1; } }   # A-Z
        if (c >= 0x61) { if (c <= 0x7A) { ok = 1; } }   # a-z
        if (ok == 0) {
            var j = 0;
            while (j < elen) {
                if (c == load8(extra_cstr + j)) { ok = 1; }
                j = j + 1;
            }
        }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Module path: [A-Za-z0-9._/-], 1..255.
fn _pam_valid_module(sv): i64 { return _pam_str_allowed(sv, "._/-", 255); }

# Rule argument: module charset plus the =,:@ that real PAM args use.
fn _pam_valid_arg(sv): i64 { return _pam_str_allowed(sv, "._/-=,:@[]", 255); }

# Service name — becomes a path component under /etc/pam.d/, so no '/'
# and no leading '.' (which kills "." and ".." along with dotfiles).
fn _pam_valid_service_name(name_cstr): i64 {
    if (name_cstr == 0) { return 0; }
    var n = strlen(name_cstr);
    if (n == 0) { return 0; }
    if (n > 64) { return 0; }
    if (load8(name_cstr) == 0x2E) { return 0; }         # leading '.'
    var i = 0;
    while (i < n) {
        var c = load8(name_cstr + i);
        var ok = 0;
        if (c >= 0x30) { if (c <= 0x39) { ok = 1; } }   # 0-9
        if (c >= 0x41) { if (c <= 0x5A) { ok = 1; } }   # A-Z
        if (c >= 0x61) { if (c <= 0x7A) { ok = 1; } }   # a-z
        if (c == 0x2E) { ok = 1; }                      # .
        if (c == 0x2D) { ok = 1; }                      # -
        if (c == 0x5F) { ok = 1; }                      # _
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Every byte of `sv` is an ASCII digit.
fn _pam_all_digits(sv): i64 {
    var n = str_len(sv);
    if (n == 0) { return 0; }
    var d = str_data(sv);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 0x30) { return 0; }
        if (c > 0x39) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# PAM service constants
# ================================================================

enum PamServiceId {
    PAM_SVC_LOGIN = 0;
    PAM_SVC_SUDO = 1;
    PAM_SVC_SSHD = 2;
    PAM_SVC_AGNOS_AGENT = 3;
    PAM_SVC_CUSTOM = 4;
}

# Get the config filename for a PAM service ID.
# Returns a C string pointer.
fn pam_service_name(svc_id): i64 {
    if (svc_id == PAM_SVC_LOGIN) { return "login"; }
    if (svc_id == PAM_SVC_SUDO) { return "sudo"; }
    if (svc_id == PAM_SVC_SSHD) { return "sshd"; }
    if (svc_id == PAM_SVC_AGNOS_AGENT) { return "agnos-agent"; }
    return "unknown";
}

# ================================================================
# PAM rule type constants
# ================================================================

enum PamRuleTypeId {
    PAM_TYPE_AUTH = 0;
    PAM_TYPE_ACCOUNT = 1;
    PAM_TYPE_SESSION = 2;
    PAM_TYPE_PASSWORD = 3;
}

fn pam_rule_type_name(t): i64 {
    if (t == PAM_TYPE_AUTH) { return "auth"; }
    if (t == PAM_TYPE_ACCOUNT) { return "account"; }
    if (t == PAM_TYPE_SESSION) { return "session"; }
    if (t == PAM_TYPE_PASSWORD) { return "password"; }
    return "unknown";
}

# Parse rule type from Str. Returns type id or -1 on error.
fn pam_parse_rule_type(s): i64 {
    if (str_eq_cstr(s, "auth") == 1) { return PAM_TYPE_AUTH; }
    if (str_eq_cstr(s, "account") == 1) { return PAM_TYPE_ACCOUNT; }
    if (str_eq_cstr(s, "session") == 1) { return PAM_TYPE_SESSION; }
    if (str_eq_cstr(s, "password") == 1) { return PAM_TYPE_PASSWORD; }
    return 0 - 1;
}

# ================================================================
# PAM control flag constants
# ================================================================

enum PamControlId {
    PAM_CTL_REQUIRED = 0;
    PAM_CTL_REQUISITE = 1;
    PAM_CTL_SUFFICIENT = 2;
    PAM_CTL_OPTIONAL = 3;
    PAM_CTL_INCLUDE = 4;
    # Linux-PAM's bracketed value=action form, e.g.
    # `[success=1 default=bad]`. The raw text is kept on the rule's
    # control_text field so render reproduces it verbatim; collapsing it to
    # one of the four keywords above would silently change the stack.
    PAM_CTL_BRACKET = 5;
}

fn pam_control_name(c): i64 {
    if (c == PAM_CTL_REQUIRED) { return "required"; }
    if (c == PAM_CTL_REQUISITE) { return "requisite"; }
    if (c == PAM_CTL_SUFFICIENT) { return "sufficient"; }
    if (c == PAM_CTL_OPTIONAL) { return "optional"; }
    if (c == PAM_CTL_INCLUDE) { return "include"; }
    if (c == PAM_CTL_BRACKET) { return "bracket"; }
    return "unknown";
}

# Parse control flag from Str. Returns control id or -1 on error.
fn pam_parse_control(s): i64 {
    if (str_eq_cstr(s, "required") == 1) { return PAM_CTL_REQUIRED; }
    if (str_eq_cstr(s, "requisite") == 1) { return PAM_CTL_REQUISITE; }
    if (str_eq_cstr(s, "sufficient") == 1) { return PAM_CTL_SUFFICIENT; }
    if (str_eq_cstr(s, "optional") == 1) { return PAM_CTL_OPTIONAL; }
    if (str_eq_cstr(s, "include") == 1) { return PAM_CTL_INCLUDE; }
    if (str_len(s) > 1) {
        var d = str_data(s);
        if (load8(d) == 0x5B) {                          # '['
            if (load8(d + str_len(s) - 1) == 0x5D) { return PAM_CTL_BRACKET; }
        }
    }
    return 0 - 1;
}

# ================================================================
# PamRule struct — 6 fields * 8 = 48 bytes.
# Field name `type` matches the 1.0 getter `pam_rule_type/1`
# (not the constructor arg name `rule_type`).
#
# `optional` records Linux-PAM's leading `-` on the type ("skip silently
# if the module is missing"); `control_text` holds the raw bracketed
# control expression when control == PAM_CTL_BRACKET, 0 otherwise. Both
# exist so a parsed real-world config renders back byte-for-byte instead
# of being flattened into a different policy.
# ================================================================

#derive(accessors)
struct pam_rule { type; control; module; args; optional; control_text; }

fn pam_rule_new(rule_type, control, module, args): i64 {
    var r = alloc(48);
    pam_rule_set_type(r, rule_type);
    pam_rule_set_control(r, control);
    pam_rule_set_module(r, module);
    pam_rule_set_args(r, args);
    pam_rule_set_optional(r, 0);
    pam_rule_set_control_text(r, 0);
    return r;
}

# ================================================================
# UserInfo struct — 7 fields * 8 = 56 bytes.
# Field `home` matches the 1.0 getter (not the constructor arg
# `home_dir`). Field `groups_arr` dodges the 3-arg
# `pam_user_set_groups(u, groups, is_system)/3` collision; the
# 1.0 `pam_user_groups/1` getter and 3-arg setter stay as thin
# wrappers. The 6-arg multi-field setter `pam_user_set/6` keeps
# its name and delegates through the derive setters.
# ================================================================

#derive(accessors)
struct pam_user {
    username;
    uid;
    gid;
    home;
    shell;
    groups_arr;
    is_system;
}

fn pam_user_alloc(): i64 {
    var u = alloc(56);
    memset(u, 0, 56);
    return u;
}

fn pam_user_set(u, username, uid, gid, home_dir, shell): i64 {
    pam_user_set_username(u, username);
    pam_user_set_uid(u, uid);
    pam_user_set_gid(u, gid);
    pam_user_set_home(u, home_dir);
    pam_user_set_shell(u, shell);
    return u;
}

# 1.0 API preservation — `groups` getter + 3-arg `set_groups`
# delegate through the derive accessors.
fn pam_user_groups(u): i64 { return pam_user_groups_arr(u); }
fn pam_user_set_groups(u, groups, is_system): i64 {
    pam_user_set_groups_arr(u, groups);
    pam_user_set_is_system(u, is_system);
    return u;
}

# ================================================================
# SessionInfo struct — 6 fields * 8 = 48 bytes.
# Field `id` matches the 1.0 getter `pam_session_id/1`
# (not the constructor arg `session_id`).
# ================================================================

#derive(accessors)
struct pam_session { id; user; login_time; tty; remote_host; pid; }

fn pam_session_new(session_id, user, login_time, tty, remote_host, pid): i64 {
    var s = alloc(48);
    pam_session_set_id(s, session_id);
    pam_session_set_user(s, user);
    pam_session_set_login_time(s, login_time);
    pam_session_set_tty(s, tty);
    pam_session_set_remote_host(s, remote_host);
    pam_session_set_pid(s, pid);
    return s;
}

# ================================================================
# Username validation
# ================================================================

# Validate a UNIX username.
# Rules: max 32 chars, must start with lowercase letter or underscore,
# may contain lowercase letters, digits, hyphens, underscores.
# Returns Result: Ok(0) on valid, Err on invalid.
fn pam_validate_username(name): i64 {
    var nlen = strlen(name);
    if (nlen == 0) {
        return stik_err_invalid_argument("username cannot be empty");
    }
    if (nlen > 32) {
        return stik_err_invalid_argument("username too long (max 32 chars)");
    }

    # First character must be lowercase letter or underscore
    var first = load8(name);
    var first_ok = 0;
    if (first >= 97) { if (first <= 122) { first_ok = 1; } }  # a-z
    if (first == 95) { first_ok = 1; }  # _
    if (first_ok == 0) {
        return stik_err_invalid_argument("username must start with lowercase letter or underscore");
    }

    # Remaining characters: a-z, 0-9, -, _
    var i = 0;
    while (i < nlen) {
        var ch = load8(name + i);
        var ch_ok = 0;
        if (ch >= 97) { if (ch <= 122) { ch_ok = 1; } }  # a-z
        if (ch >= 48) { if (ch <= 57) { ch_ok = 1; } }    # 0-9
        if (ch == 45) { ch_ok = 1; }   # -
        if (ch == 95) { ch_ok = 1; }   # _
        if (ch_ok == 0) {
            return stik_err_invalid_argument("username contains invalid character");
        }
        i = i + 1;
    }

    return Ok(0);
}

# ================================================================
# Parse a single /etc/passwd line into a UserInfo struct
# ================================================================

# Format: username:x:uid:gid:gecos:home:shell
# Returns Result: Ok(user_info_ptr) or Err.
fn pam_parse_passwd_line(line): i64 {
    # Split by ':'
    var fields = str_split(line, 58);  # 58 = ':'
    if (vec_len(fields) < 7) {
        return stik_err_invalid_argument("malformed passwd line (expected 7 fields)");
    }

    # Cloned for the same reason as pam_split_whitespace's parts: str_split
    # borrows the line's buffer without terminating, and these three become
    # public record fields.
    var username = str_clone(vec_get(fields, 0));
    # fields[1] = password placeholder (x)
    var uid_str = vec_get(fields, 2);
    var gid_str = vec_get(fields, 3);
    # fields[4] = gecos
    var home_dir = str_clone(vec_get(fields, 5));
    var shell = str_clone(vec_get(fields, 6));

    var uid = str_to_int(uid_str);
    var gid = str_to_int(gid_str);

    # str_to_int skips non-digits silently and returns 0 for a wholly
    # non-numeric field — so "alice:x:root:root:..." used to parse as uid 0,
    # gid 0, is_system=1. The comment here always claimed this was checked;
    # now it is.
    if (_pam_all_digits(uid_str) == 0) {
        return stik_err_invalid_argument("non-numeric UID in passwd line");
    }
    if (_pam_all_digits(gid_str) == 0) {
        return stik_err_invalid_argument("non-numeric GID in passwd line");
    }

    # Heuristic: UIDs below 1000 are system users
    var is_system = 0;
    if (uid < 1000) { is_system = 1; }

    var groups = vec_new();
    var user = pam_user_alloc();
    pam_user_set(user, username, uid, gid, home_dir, shell);
    pam_user_set_groups(user, groups, is_system);
    return Ok(user);
}

# ================================================================
# Parse who output into a vec of SessionInfo
# ================================================================

# Typical who output lines:
#   alice    pts/0        2026-03-06 10:30 (192.168.1.5)
#   bob      tty1         2026-03-06 09:15
# Returns vec of session info pointers.
fn pam_parse_who_output(output): i64 {
    var sessions = vec_new();
    var lines = str_split(output, 10);  # 10 = '\n'
    var idx = 0;

    while (idx < vec_len(lines)) {
        var line = str_trim(vec_get(lines, idx));
        if (str_len(line) == 0) {
            idx = idx + 1;
            continue;
        }

        # Split by whitespace (space = 32)
        # who output is whitespace-delimited; we need at least 3 fields
        var parts = pam_split_whitespace(line);
        if (vec_len(parts) < 3) {
            idx = idx + 1;
            continue;
        }

        var user = vec_get(parts, 0);
        var tty = vec_get(parts, 1);

        # Date + time may be in columns 2+3
        var login_time = vec_get(parts, 2);
        if (vec_len(parts) >= 4) {
            var sb = str_builder_new();
            str_builder_add(sb, vec_get(parts, 2));
            str_builder_add_cstr(sb, " ");
            str_builder_add(sb, vec_get(parts, 3));
            login_time = str_builder_build(sb);
        }

        # Remote host is in parens at the end, e.g. "(192.168.1.5)"
        var remote_host = 0;
        var last_part = vec_get(parts, vec_len(parts) - 1);
        if (str_len(last_part) > 2) {
            var ld = str_data(last_part);
            var ll = str_len(last_part);
            if (load8(ld) == 40) {  # '('
                if (load8(ld + ll - 1) == 41) {  # ')'
                    remote_host = str_clone(str_sub(last_part, 1, ll - 2));
                }
            }
        }

        # session_id = "who-<idx>"
        var sid_sb = str_builder_new();
        str_builder_add_cstr(sid_sb, "who-");
        str_builder_add_int(sid_sb, idx);
        var session_id = str_builder_build(sid_sb);

        var session = pam_session_new(session_id, user, login_time, tty, remote_host, 0);
        vec_push(sessions, session);

        idx = idx + 1;
    }

    return sessions;
}

# Split a Str by whitespace (space/tab), skipping consecutive whitespace.
# Returns vec of Str.
# Parts are CLONED, not borrowed. str_new/str_sub share the parent's buffer
# and do not NUL-terminate, so a borrowed part's str_data() reads on into
# the rest of the line — and these parts become record fields exposed
# through public getters, where ADR 0002 makes str_data() the unwrap.
fn pam_split_whitespace(s): i64 {
    var parts = vec_new();
    var slen = str_len(s);
    var sd = str_data(s);
    var start = 0;
    var in_word = 0;
    var i = 0;

    while (i < slen) {
        var ch = load8(sd + i);
        var is_ws = 0;
        if (ch == 32) { is_ws = 1; }   # space
        if (ch == 9) { is_ws = 1; }    # tab

        if (is_ws == 1) {
            if (in_word == 1) {
                vec_push(parts, str_clone(str_new(sd + start, i - start)));
                in_word = 0;
            }
        }
        else {
            if (in_word == 0) {
                start = i;
                in_word = 1;
            }
        }
        i = i + 1;
    }

    # Trailing word
    if (in_word == 1) {
        vec_push(parts, str_clone(str_new(sd + start, slen - start)));
    }

    return parts;
}

# ================================================================
# Parse PAM config file content
# ================================================================

# Parse PAM config text into a vec of PamRule pointers.
# Each non-blank, non-comment line: type control module [args...]
# Returns Result: Ok(vec_of_rules) or Err.
fn pam_parse_config(content): i64 {
    var rules = vec_new();
    var lines = str_split(content, 10);  # 10 = '\n'
    var idx = 0;

    while (idx < vec_len(lines)) {
        var line = str_trim(vec_get(lines, idx));
        if (str_len(line) == 0) {
            idx = idx + 1;
            continue;
        }

        # Skip comments (lines starting with #)
        if (load8(str_data(line)) == 35) {  # '#'
            idx = idx + 1;
            continue;
        }

        var parts = pam_split_whitespace(line);
        var nparts = vec_len(parts);
        if (nparts < 3) {
            return stik_err_invalid_argument("malformed PAM rule (need type, control, module)");
        }

        # A leading '-' on the type means "skip silently if the module is
        # absent". 14 of the lines in this host's own /etc/pam.d use it;
        # without this the whole file was rejected.
        var type_tok = vec_get(parts, 0);
        var optional = 0;
        if (str_len(type_tok) > 1) {
            if (load8(str_data(type_tok)) == 0x2D) {     # '-'
                optional = 1;
                type_tok = str_sub(type_tok, 1, str_len(type_tok) - 1);
            }
        }

        var rule_type = pam_parse_rule_type(type_tok);
        if (rule_type < 0) {
            return stik_err_invalid_argument("unknown PAM rule type");
        }

        # The bracketed control form contains spaces, so pam_split_whitespace
        # has already torn it into several tokens — rejoin from '[' to the
        # token ending in ']'.
        var ci = 1;
        var ctl_tok = vec_get(parts, 1);
        var control_text = 0;
        if (str_len(ctl_tok) > 0) {
            if (load8(str_data(ctl_tok)) == 0x5B) {      # '['
                var csb = str_builder_new();
                var closed = 0;
                while (ci < nparts) {
                    var tok = vec_get(parts, ci);
                    if (ci > 1) { str_builder_add_cstr(csb, " "); }
                    str_builder_add(csb, tok);
                    var tl = str_len(tok);
                    if (tl > 0) {
                        if (load8(str_data(tok) + tl - 1) == 0x5D) {   # ']'
                            closed = 1;
                            ci = ci + 1;
                            break;
                        }
                    }
                    ci = ci + 1;
                }
                if (closed == 0) {
                    return stik_err_invalid_argument("unterminated PAM control expression");
                }
                control_text = str_builder_build(csb);
                ctl_tok = control_text;
            } else {
                ci = 2;
            }
        } else {
            ci = 2;
        }

        var control = pam_parse_control(ctl_tok);
        if (control < 0) {
            return stik_err_invalid_argument("unknown PAM control flag");
        }
        if (control != PAM_CTL_BRACKET) { control_text = 0; }

        if (ci >= nparts) {
            return stik_err_invalid_argument("malformed PAM rule (missing module)");
        }
        var module = vec_get(parts, ci);

        # Collect remaining parts as args
        var args = vec_new();
        var ai = ci + 1;
        while (ai < nparts) {
            vec_push(args, vec_get(parts, ai));
            ai = ai + 1;
        }

        var rule = pam_rule_new(rule_type, control, module, args);
        pam_rule_set_optional(rule, optional);
        pam_rule_set_control_text(rule, control_text);
        vec_push(rules, rule);

        idx = idx + 1;
    }

    return Ok(rules);
}

# ================================================================
# List PAM services (read /etc/pam.d/ directory)
# ================================================================

# Returns Result: Ok(vec_of_Str) — filenames in /etc/pam.d/.
fn pam_list_services(): i64 {
    var pam_dir = str_from("/etc/pam.d");
    var entries = dir_list(pam_dir);
    return Ok(entries);
}

# ================================================================
# Read and parse a PAM service config file
# ================================================================

# Read /etc/pam.d/<service_name> and parse it.
# service_name: C string (e.g. "sshd", "sudo").
# Returns Result: Ok(vec_of_rules) or Err.
fn pam_read_service_config(service_name): i64 {
    # The name is concatenated into a path, so it is a path component and
    # must be validated as one. Unchecked, "../../tmp/fifo" both escaped
    # /etc/pam.d and — because a bare O_RDONLY open on a FIFO with no writer
    # blocks in the kernel forever — hung the daemon permanently.
    if (_pam_valid_service_name(service_name) == 0) {
        return stik_err_invalid_argument("invalid PAM service name");
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/etc/pam.d/");
    str_builder_add_cstr(sb, service_name);
    var path = str_builder_build(sb);

    # O_NOFOLLOW mirrors the F-6 scanner fix: a symlink planted at
    # /etc/pam.d/<name> must not redirect the read.
    var fd = sys_open(str_data(path), O_RDONLY | O_CLOEXEC | _PAM_O_NOFOLLOW, 0);
    if (fd < 0) {
        return stik_err_io("failed to open PAM config file");
    }
    defer { sys_close(fd); }

    var content = pam_read_fd_to_str(fd, 8192);

    return pam_parse_config(content);
}

# ================================================================
# List users from /etc/passwd
# ================================================================

# Read /etc/passwd and return vec of UserInfo pointers.
# Returns Result: Ok(vec) or Err.
fn pam_list_users(): i64 {
    var fd = sys_open("/etc/passwd", O_RDONLY | O_CLOEXEC | _PAM_O_NOFOLLOW, 0);
    if (fd < 0) {
        return stik_err_io("failed to open /etc/passwd");
    }
    defer { sys_close(fd); }

    var content = pam_read_fd_to_str(fd, 65536);
    var lines = str_split(content, 10);  # '\n'
    var users = vec_new();

    var idx = 0;
    while (idx < vec_len(lines)) {
        var line = str_trim(vec_get(lines, idx));
        if (str_len(line) == 0) {
            idx = idx + 1;
            continue;
        }
        # Skip comments
        if (load8(str_data(line)) == 35) {
            idx = idx + 1;
            continue;
        }
        var ptag, puser = pam_parse_passwd_line(line);
        if (is_ok(ptag) == 1) {
            vec_push(users, puser);
        }
        # Skip malformed lines silently
        idx = idx + 1;
    }

    return Ok(users);
}

# ================================================================
# List active sessions via who command
# ================================================================

# Run `who` and parse output into vec of SessionInfo.
# Returns Result: Ok(vec) or Err.
fn pam_list_sessions(): i64 {
    # cap+1: run_capture fills up to `cap` and returns exactly that on a full
    # buffer, so the NUL below would land one byte past a cap-sized
    # allocation. pam_read_fd_to_str already allocates cap+1; this site did
    # not.
    var buf = alloc(_PAM_WHO_CAP + 1);
    var rtag, nbytes = run_capture("/usr/bin/who", 0, 0, buf, _PAM_WHO_CAP);
    if (is_err_result(rtag) == 1) {
        return stik_err_io("failed to run who command");
    }
    store8(buf + nbytes, 0);
    var output = str_new(buf, nbytes);
    var sessions = pam_parse_who_output(output);
    return Ok(sessions);
}

# ================================================================
# Render PAM rule to string
# ================================================================

# Render a single PamRule to a config-file line (Str).
# Returns 0 when the rule fails validation. Rendering is the injection sink,
# so it refuses to emit anything pam_validate_rule would reject rather than
# trusting the caller to have validated first.
fn pam_render_rule(rule): i64 {
    if (is_err_result(pam_validate_rule(rule)) == 1) { return 0; }
    var sb = str_builder_new();
    if (pam_rule_optional(rule) == 1) { str_builder_add_cstr(sb, "-"); }
    str_builder_add_cstr(sb, pam_rule_type_name(pam_rule_type(rule)));
    str_builder_add_cstr(sb, "\t");
    var ctext = pam_rule_control_text(rule);
    if (pam_rule_control(rule) == PAM_CTL_BRACKET) {
        if (ctext == 0) { return 0; }
        str_builder_add(sb, ctext);
    } else {
        str_builder_add_cstr(sb, pam_control_name(pam_rule_control(rule)));
    }
    str_builder_add_cstr(sb, "\t");
    str_builder_add(sb, pam_rule_module(rule));

    var args = pam_rule_args(rule);
    var nargs = vec_len(args);
    var ai = 0;
    while (ai < nargs) {
        str_builder_add_cstr(sb, "\t");
        str_builder_add(sb, vec_get(args, ai));
        ai = ai + 1;
    }

    return str_builder_build(sb);
}

# Render a full PAM config from a vec of PamRule pointers.
# Returns Str.
fn pam_render_config(rules): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# Generated by AGNOS PAM manager\n");

    var nrules = vec_len(rules);
    var idx = 0;
    while (idx < nrules) {
        var line = pam_render_rule(vec_get(rules, idx));
        # Fail closed on the whole document: emitting a config with one rule
        # silently dropped would weaken the stack just as surely as emitting
        # the bad rule would.
        if (line == 0) { return 0; }
        str_builder_add(sb, line);
        str_builder_add_cstr(sb, "\n");
        idx = idx + 1;
    }

    return str_builder_build(sb);
}

# ================================================================
# Validate a PAM rule
# ================================================================

# Check module path is reasonable and args have no shell metacharacters.
# Returns Result: Ok(0) on valid, Err on invalid.
fn pam_validate_rule(rule): i64 {
    var module = pam_rule_module(rule);
    if (str_len(module) == 0) {
        return stik_err_invalid_argument("PAM module path cannot be empty");
    }

    # Module must not contain ".."
    if (str_contains_cstr(module, "..") == 1) {
        return stik_err_invalid_argument("PAM module path must not contain '..'");
    }

    # Allowlist. Replaces a ten-byte denylist that let TAB, LF, CR, NUL and
    # every high byte through — and pam_render_rule joins fields with TAB
    # while pam_render_config joins lines with LF, so a surviving LF became a
    # whole extra PAM stack entry in the rendered config (e.g. an injected
    # `auth sufficient pam_permit.so`, which authenticates every password).
    if (_pam_valid_module(module) == 0) {
        return stik_err_invalid_argument("PAM module path has a disallowed character");
    }

    # The bracket expression is rendered verbatim, so it is an injection sink
    # exactly like module and args. Space is legal inside it and nowhere else.
    if (pam_rule_control(rule) == PAM_CTL_BRACKET) {
        var ctext = pam_rule_control_text(rule);
        if (ctext == 0) {
            return stik_err_invalid_argument("bracket control with no text");
        }
        if (_pam_str_allowed(ctext, "[]= _-", 255) == 0) {
            return stik_err_invalid_argument("PAM control expression has a disallowed character");
        }
    }

    var args = pam_rule_args(rule);
    var nargs = vec_len(args);
    var ai = 0;
    while (ai < nargs) {
        if (_pam_valid_arg(vec_get(args, ai)) == 0) {
            return stik_err_invalid_argument("PAM arg has a disallowed character");
        }
        ai = ai + 1;
    }

    return Ok(0);
}

# ================================================================
# Get user info by username
# ================================================================

# Lookup a user in /etc/passwd by name.
# Returns Result: Ok(user_info_ptr) or Err.
fn pam_get_user_info(username): i64 {
    var vtag, verr = pam_validate_username(username);
    if (is_err_result(vtag) == 1) { return Err(verr); }

    var fd = sys_open("/etc/passwd", O_RDONLY | O_CLOEXEC | _PAM_O_NOFOLLOW, 0);
    if (fd < 0) {
        return stik_err_io("failed to open /etc/passwd");
    }
    defer { sys_close(fd); }

    var content = pam_read_fd_to_str(fd, 65536);
    var lines = str_split(content, 10);
    var name_str = str_from(username);

    var idx = 0;
    while (idx < vec_len(lines)) {
        var line = vec_get(lines, idx);
        if (str_len(line) == 0) {
            idx = idx + 1;
            continue;
        }

        # Check if line starts with username:
        var fields = str_split(line, 58);  # ':'
        if (vec_len(fields) >= 1) {
            if (str_eq(vec_get(fields, 0), name_str) == 1) {
                return pam_parse_passwd_line(line);
            }
        }
        idx = idx + 1;
    }

    return stik_err_invalid_argument("user not found");
}
