[package]
name = "aegis"
version = "${file:VERSION}"
description = "aegis — security daemon for AGNOS"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.2"

[build]
entry = "src/main.cyr"
output = "aegis"

# This file is a build manifest — declarations only. Why each dep is here
# and what aegis calls from it: docs/development/state.md, Dependencies.
# What changed between versions: CHANGELOG.md.
#
# `path` is a local dev override. When the sibling checkout exists it
# shadows `tag` outright; CI has no siblings and resolves `tag` from git.
# Both must stay correct.
[deps]
# Modules aegis source includes directly — every `include "lib/X.cyr"` in
# src/ must have its X listed here. Transitive requirements are not declared
# here: `cyrius deps` reads each dep's own manifest and the `.deps` sidecar
# beside its dist bundle, and resolves those itself.
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "tagged", "chrono", "hashmap", "bench", "fnptr", "sakshi", "bayan", "random", "process", "fs"]

# agent_id_new (UUID v4 over getrandom) from types; the
# stik_err_invalid_argument / stik_err_io constructors from error.
[deps.agnostik]
git = "https://github.com/MacCracken/agnostik.git"
path = "../agnostik"
tag = "1.4.0"
modules = ["src/types.cyr", "src/error.cyr"]

# nftables ruleset generation for the QA_ISOLATE / QA_RATELIMIT quarantine
# actions and the hardened-host baseline. src/firewall.cyr calls the
# firewall_ / table_ / chain_ / rule_ / match_ / verdict_ surface of the
# single-file dist bundle. nein pins its own audit-chain and MCP
# transitives (libro, majra, bote-core, sigil, patra) in its manifest;
# `cyrius deps` walks that graph, so aegis declares none of them. None is
# reachable from the firewall path — all are DCE-dropped.
[deps.nein]
git = "https://github.com/MacCracken/nein.git"
path = "../nein"
tag = "1.6.11"
modules = ["dist/nein.cyr"]
